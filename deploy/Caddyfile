# Production origin, reachable only by cloudflared on the compose network.
# Cloudflare Access protects ai.atheena.online/app and /app/*.
# The API independently validates signed Access JWTs; /v1 uses personal API keys.
{
  auto_https off
}
:80 {
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    X-Frame-Options DENY
    Strict-Transport-Security "max-age=31536000"
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'none'; object-src 'none'"
    Cache-Control no-store
  }
  @gateway path /v1/* /app/api/*
  handle @gateway {
    reverse_proxy api:8000 {
      flush_interval -1
    }
  }
  handle / {
    root * /srv
    rewrite * /home.html
    file_server
  }
  @publicAssets path /assets/* /brand/*
  handle @publicAssets {
    root * /srv
    file_server
  }
  @portal path /app /app/*
  handle @portal {
    root * /srv
    rewrite * /index.html
    file_server
  }
  handle {
    respond 404
  }
}
