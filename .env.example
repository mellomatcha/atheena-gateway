# Copy to .env (never committed) and fill in real values. All values below are fake examples.

# development | test | production (aliases: dev, prod)
APP_ENV=development

# Postgres 16 and Redis 7 (native on VM 999; Docker services on CI/servers).
DATABASE_URL=postgresql+asyncpg://agent@/atheena?host=/var/run/postgresql
REDIS_URL=redis://127.0.0.1:6379/0

# Upstream router (9Router). Moving to CT 300 only requires changing this URL.
UPSTREAM_BASE_URL=http://10.10.10.13:3000/v1
UPSTREAM_API_KEY=replace-with-9router-dev-key

# Admin account created by `make seed`.
SEED_ADMIN_EMAIL=admin@example.com

# Used by `make test` only (never the development database).
TEST_DATABASE_URL=postgresql+asyncpg://agent@/atheena_test?host=/var/run/postgresql
TEST_REDIS_URL=redis://127.0.0.1:6379/15

# Cloudflare Access (dashboard login). Required when APP_ENV=production.
# Team domain from Zero Trust > Settings, AUD tag from the portal Access application.
CF_ACCESS_TEAM_DOMAIN=example-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-access-application-aud-tag

# Development only: skip Cloudflare Access and act as this email. Ignored unless
# APP_ENV=development; the app refuses to start in production if this is set.
DEV_AUTH_EMAIL=

# Optional secret for hashing client IPs in the requests table.
IP_HASH_SECRET=
