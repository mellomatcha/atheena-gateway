# Copy to .env (never committed) and fill in real values. All values below are fake examples.

# development | test | production
APP_ENV=development

# Postgres 16 and Redis 7 (native on VM 999; Docker services on CI/servers).
DATABASE_URL=postgresql+asyncpg://agent@/atheena?host=/var/run/postgresql
REDIS_URL=redis://127.0.0.1:6379/0

# Upstream router (9Router). Moving to CT 300 only requires changing this URL.
UPSTREAM_BASE_URL=http://10.10.10.13:3000/v1
UPSTREAM_API_KEY=replace-with-9router-dev-key

# Admin account created by `make seed`.
SEED_ADMIN_EMAIL=admin@example.com

# Used by `make test` only (never the development database).
TEST_DATABASE_URL=postgresql+asyncpg://agent@/atheena_test?host=/var/run/postgresql
TEST_REDIS_URL=redis://127.0.0.1:6379/15
